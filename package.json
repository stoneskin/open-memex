{
  "name": "open-memex",
  "version": "0.6.0-alpha.10",
  "description": "Local-first memory layer and protocol for AI coding agents. Markdown source of truth, SQLite FTS5 index, zero cloud.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stoneskin/open-memex.git"
  },
  "homepage": "https://github.com/stoneskin/open-memex#readme",
  "bugs": {
    "url": "https://github.com/stoneskin/open-memex/issues"
  },
  "main": "src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "cli": "node --experimental-strip-types src/cli.ts",
    "mcp": "node --experimental-strip-types src/mcp.ts",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "postinstall": "node scripts/postinstall.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "better-sqlite3": "^11.7.0",
    "js-yaml": "^4.1.0",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.18.30",
    "@types/better-sqlite3": "^7.6.11",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "bin": {
    "open-memex": "dist/cli.js"
  },
  "engines": {
    "node": ">=22.6"
  }
}
