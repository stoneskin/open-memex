{
  "name": "open-memex",
  "version": "0.8.1-alpha.4",
  "mcpName": "io.github.stoneskin/open-memex",
  "description": "Local-first memory layer and protocol for AI coding agents. Markdown source of truth, SQLite FTS5 index, zero cloud.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "opencode",
    "ai-agents",
    "agent-memory",
    "persistent-memory",
    "local-first",
    "sqlite",
    "fts5",
    "markdown",
    "memory",
    "copilot",
    "cursor",
    "claude-code",
    "vscode",
    "knowledge-management",
    "developer-tools",
    "synonyms"
  ],
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stoneskin/open-memex.git"
  },
  "homepage": "https://github.com/stoneskin/open-memex#readme",
  "bugs": {
    "url": "https://github.com/stoneskin/open-memex/issues"
  },
  "main": "src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "cli": "node --experimental-strip-types src/cli.ts",
    "mcp": "node --experimental-strip-types src/mcp.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/build-stamp.mjs",
    "prepublishOnly": "npm run build",
    "postinstall": "node scripts/postinstall.js",
    "test-full": "node --experimental-strip-types scripts/test-full.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "better-sqlite3": "^13.0.3",
    "js-yaml": "^4.1.0",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.18.30",
    "@types/better-sqlite3": "^7.6.11",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "bin": {
    "open-memex": "dist/cli.js"
  },
  "engines": {
    "node": ">=22.14.0"
  }
}
